{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "冰岩开放平台",
  "colors": {
    "primary": "#087C6E",
    "light": "#2BA58F",
    "dark": "#065F55"
  },
  "favicon": {
    "light": "/images/favicon.svg",
    "dark": "/images/favicon.svg"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "冰岩作坊",
          "href": "https://www.bingyan.net/"
        },
        {
          "anchor": "Hustoday",
          "href": "https://app.hust.online"
        }
      ]
    },
    "languages": [
      {
        "language": "cn",
        "default": true,
        "tabs": [
          {
            "tab": "指南",
            "groups": [
              {
                "group": "开始使用",
                "pages": [
                  "index",
                  "quickstart"
                ]
              },
              {
                "group": "接入方式",
                "pages": [
                  "mcp-tools",
                  "capabilities"
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "openapi": "openapi.json"
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo.svg",
    "dark": "/images/logo.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "控制台",
      "href": "https://open-dev.bingyan.net/console/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "mcp"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/BingyanStudio"
    }
  },
  "markdown": {
    "schema": true
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "url": "full",
    "mdx": {
      "server": "https://open-dev-api.bingyan.net",
      "auth": {
        "method": "bearer"
      }
    }
  },
  "appearance": {
    "default": "light",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#F4F8F7",
      "dark": "#0E1514"
    }
  }
}
