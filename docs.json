{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "冰岩开放平台",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": {
    "light": "/images/favicon.svg",
    "dark": "/images/favicon.svg"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "冰岩作坊",
          "href": "https://www.bingyan.net/"
        },
        {
          "anchor": "Hustoday",
          "href": "https://app.hust.online"
        }
      ]
    },
    "languages": [
      {
        "language": "cn",
        "default": true,
        "hidden": true,
        "groups": [
          {
            "group": "开始使用",
            "pages": [
              "index",
              "quickstart"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/logo.svg",
    "dark": "/images/logo.svg"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "回到控制台",
      "href": "/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "mcp"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/BingyanStudio"
    }
  },
  "markdown": {
    "schema": true
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "url": "full"
  }
}
