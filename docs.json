{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "冰岩开放平台",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": {
    "light": "/images/favicon.svg",
    "dark": "/images/favicon.svg"
  },
  "navigation": {
    "pages": [
      {
        "group": "Getting Started",
        "pages": [
          "index",
          "quickstart"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "主站",
          "href": "https://open-bingyan-dev.hust.online/"
        },
        {
          "anchor": "冰岩作坊",
          "href": "https://www.bingyan.net/"
        },
        {
          "anchor": "Hustoday",
          "href": "https://app.hust.online"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/logo.svg",
    "dark": "/images/logo.svg"
  },
  "navbar": {
    "links": [
      {
        "href": "/",
        "label": "回到控制台"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "mcp"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/BingyanStudio"
    }
  },
  "markdown": {
    "schema": true
  },
  "api": {
    "playground": {
      "display": "interactive"
    },
    "url": "full"
  }
}
